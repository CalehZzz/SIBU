# Copia a /home/sibucr/SIBU/costa_rica/sibu.env y completá:
#   cp costa_rica/sibu.env.example costa_rica/sibu.env
#   nano costa_rica/sibu.env

GEMINI_API_KEY=pega_tu_key_aqui
PLC_IP=192.168.0.1
GEMINI_MODEL=gemini-3.8-flash

# RFID (ESP32 → Pi :8081)
RFID_PORT=8081
RFID_TTL_SEC=300
# UIDs hex sin dos puntos. Ej: A1B2C3D4:Caleb,DEADBEEF:Carla
RFID_ALLOW=
