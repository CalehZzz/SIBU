# Copia a /home/sibucr/SIBU/costa_rica/sibu.env y completá:
#   cp costa_rica/sibu.env.example costa_rica/sibu.env
#   nano costa_rica/sibu.env

GEMINI_API_KEY=pega_tu_key_aqui
PLC_IP=192.168.0.1
GEMINI_MODEL=gemini-3.8-flash

# RFID — Arduino Uno USB Serial → Pi (preferido: ESP WiFi, ver arduino_bins/)
RFID_PORT=8081
RFID_TTL_SEC=300
# Dejá vacío si el RC522 está en el ESP32 (POST :8081):
RFID_SERIAL=
RFID_BAUD=115200
# UIDs hex. Ej: A1B2C3D4:Caleb
RFID_ALLOW=A7240B9F:SIBUA
# También: costa_rica/rfid_allow.txt

# Botes + báscula + RFID (ESP32 WiFi → Pi)
BINS_PORT=8082
