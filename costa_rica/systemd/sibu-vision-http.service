[Unit]
Description=SIBU vision HTTP (camara Pi + Gemini, sin PLC / sin Firebase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sibucr
WorkingDirectory=/home/sibucr/SIBU
EnvironmentFile=-/home/sibucr/SIBU/costa_rica/sibu.env
ExecStart=/home/sibucr/SIBU/.venv/bin/python costa_rica/vision_http.py --port 8080 --model ${GEMINI_MODEL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
