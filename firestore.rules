rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /estaciones/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /precios/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sesiones_activas/{id} {
      allow read, write: if signedIn();
    }

    match /hmi_comandos/{id} {
      allow read, write: if signedIn();
    }

    match /registros/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Cámara Pi (cliente + Admin SDK de la Pi)
    match /vision_pi/{doc} {
      allow read, write: if signedIn();
    }

    // RFID: lectura para la web; escritura también auth
    // (la Pi usa Admin SDK y bypasea rules; el cliente puede bloquear)
    match /rfid_gate/{doc} {
      allow read, write: if signedIn();
    }

    match /rfid_tarjetas/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
